FROM node:20-alpine

WORKDIR /app
COPY . .

# Порт, на котором бот принимает запросы от игрового сервера. Хостинг ведёт
# домен бота на этот порт. Если у хостинга другой порт - поменяй обе строки
# (и api.port в config.json, если PORT хостинг не передаёт сам).
ENV PORT=3000
EXPOSE 3000

CMD ["node", "bot.js"]
